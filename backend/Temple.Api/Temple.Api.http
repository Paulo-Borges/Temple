@baseUrl = http://localhost:5022
@token = {{login.response.body.$.token}}

### ===================== AUTENTICAÇÃO =====================

### Login do Pastor (envie primeiro; o REST Client pede a senha)
# @name login
# @prompt senha Senha do Pastor inicial
POST {{baseUrl}}/api/autenticacao/login
Content-Type: application/json

{
  "email": "pastor@temple.local",
  "senha": "{{senha}}"
}

### Quem sou eu (usuário do token)
GET {{baseUrl}}/api/autenticacao/me
Authorization: Bearer {{token}}

### ===================== IGREJAS =====================


### Criar matriz
# @name criarMatriz
POST {{baseUrl}}/api/igrejas
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nome": "Igreja Sede Teste",
  "cnpj": "11.222.333/0001-81",
  "telefone": "(11) 3333-4444",
  "dataFundacao": "1990-01-01",
  "ativa": true,
  "endereco": {
    "logradouro": "Rua das Flores",
    "numero": "10",
    "complemento": null,
    "bairro": "Centro",
    "cidade": "São Paulo",
    "uf": "SP",
    "cep": "01001-000"
  }
}

### Criar filial da matriz criada acima
POST {{baseUrl}}/api/igrejas/{{criarMatriz.response.body.$.id}}/filiais
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nome": "Igreja Filial Teste",
  "cnpj": "11.222.333/0002-62",
  "telefone": "(11) 3333-5555",
  "dataFundacao": "2005-06-15",
  "ativa": true,
  "endereco": {
    "logradouro": "Avenida Brasil",
    "numero": "200",
    "complemento": "Sala 3",
    "bairro": "Jardim América",
    "cidade": "São Paulo",
    "uf": "SP",
    "cep": "01430-000"
  }
}

### Obter a matriz criada acima
GET {{baseUrl}}/api/igrejas/{{criarMatriz.response.body.$.id}}
Authorization: Bearer {{token}}

### Obter uma igreja que não existe (404)
GET {{baseUrl}}/api/igrejas/00000000-0000-0000-0000-000000000001
Authorization: Bearer {{token}}

### Campos inválidos (400)
POST {{baseUrl}}/api/igrejas
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nome": "",
  "cnpj": "123",
  "telefone": "abc",
  "dataFundacao": "2999-01-01",
  "ativa": true,
  "endereco": {
    "logradouro": "",
    "numero": "1",
    "complemento": null,
    "bairro": "Centro",
    "cidade": "São Paulo",
    "uf": "XX",
    "cep": "1234"
  }
}

### Listar todas as igrejas
GET {{baseUrl}}/api/igrejas
Authorization: Bearer {{token}}

### Listar só as igrejas ativas
GET {{baseUrl}}/api/igrejas?ativa=true
Authorization: Bearer {{token}}

### Listar as filiais da matriz criada acima
GET {{baseUrl}}/api/igrejas/{{criarMatriz.response.body.$.id}}/filiais
Authorization: Bearer {{token}}

### Atualizar a matriz criada acima
PUT {{baseUrl}}/api/igrejas/{{criarMatriz.response.body.$.id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nome": "Igreja Sede Teste Renovada",
  "telefone": "(11) 99999-8888",
  "endereco": {
    "logradouro": "Rua das Palmeiras",
    "numero": "300",
    "complemento": "Templo principal",
    "bairro": "Vila Mariana",
    "cidade": "São Paulo",
    "uf": "SP",
    "cep": "04101-000"
  }
}

### Desativar a matriz criada acima (422 enquanto houver filial ativa)
POST {{baseUrl}}/api/igrejas/{{criarMatriz.response.body.$.id}}/desativar
Authorization: Bearer {{token}}

### Ativar a matriz criada acima
POST {{baseUrl}}/api/igrejas/{{criarMatriz.response.body.$.id}}/ativar
Authorization: Bearer {{token}}


### ===================== MEMBROS =====================

### Buscar as igrejas ativas (o cadastro de membro usa a primeira)
# @name igrejasAtivas
GET {{baseUrl}}/api/igrejas?ativa=true
Authorization: Bearer {{token}}

### Cadastrar membro na primeira igreja ativa
# @name criarMembro
POST {{baseUrl}}/api/membros
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nome": "João da Silva",
  "dataNascimento": "1985-03-10",
  "endereco": {
    "logradouro": "Rua das Acácias",
    "numero": "45",
    "complemento": null,
    "bairro": "Centro",
    "cidade": "São Paulo",
    "uf": "SP",
    "cep": "01002-000"
  },
  "igrejaId": "{{igrejasAtivas.response.body.$[0].id}}",
  "cargoAtual": "Membro",
  "grupo": "Varoes"
}

### Listar membros (primeira página, 20 por página)
GET {{baseUrl}}/api/membros
Authorization: Bearer {{token}}

### Listar membros com filtros e paginação
GET {{baseUrl}}/api/membros?nome=jo&ativo=true&pagina=1&tamanhoPagina=10
Authorization: Bearer {{token}}

### Listar só os diáconos
GET {{baseUrl}}/api/membros?cargo=Diacono
Authorization: Bearer {{token}}

### Obter o membro cadastrado acima
GET {{baseUrl}}/api/membros/{{criarMembro.response.body.$.id}}
Authorization: Bearer {{token}}

### Atualizar o membro cadastrado acima
PUT {{baseUrl}}/api/membros/{{criarMembro.response.body.$.id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nome": "João Pereira da Silva",
  "endereco": {
    "logradouro": "Rua das Acácias",
    "numero": "45",
    "complemento": "Casa 2",
    "bairro": "Centro",
    "cidade": "São Paulo",
    "uf": "SP",
    "cep": "01002-000"
  },
  "grupo": "Varoes"
}

### Promover o membro cadastrado acima
POST {{baseUrl}}/api/membros/{{criarMembro.response.body.$.id}}/promocoes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "novoCargo": "Cooperador",
  "dataPromocao": "2026-01-15",
  "observacao": "Consagrado no culto de santa ceia"
}

### Rebaixar o membro cadastrado acima (o motivo na observação é obrigatório)
POST {{baseUrl}}/api/membros/{{criarMembro.response.body.$.id}}/promocoes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "novoCargo": "Membro",
  "dataPromocao": "2026-02-10",
  "observacao": "Afastado por decisão do ministério"
}

### Histórico de cargos do membro cadastrado acima
GET {{baseUrl}}/api/membros/{{criarMembro.response.body.$.id}}/historico-cargos
Authorization: Bearer {{token}}

### Desativar o membro cadastrado acima
POST {{baseUrl}}/api/membros/{{criarMembro.response.body.$.id}}/desativar
Authorization: Bearer {{token}}

### Ativar o membro cadastrado acima
POST {{baseUrl}}/api/membros/{{criarMembro.response.body.$.id}}/ativar
Authorization: Bearer {{token}}



### ===================== ANIVERSARIANTES =====================

### Aniversariantes do mês atual
GET {{baseUrl}}/api/membros/aniversariantes
Authorization: Bearer {{token}}

### Aniversariantes de março
GET {{baseUrl}}/api/membros/aniversariantes?mes=3
Authorization: Bearer {{token}}

### Aniversariantes do mês atual na primeira igreja ativa
GET {{baseUrl}}/api/membros/aniversariantes?igrejaId={{igrejasAtivas.response.body.$[0].id}}
Authorization: Bearer {{token}}

### Mês inválido (400)
GET {{baseUrl}}/api/membros/aniversariantes?mes=13
Authorization: Bearer {{token}}


### ===================== USUÁRIOS (só o Pastor) =====================

### Criar a Secretária (o REST Client pede a senha inicial)
# @name criarUsuario
# @prompt senhaInicial Senha inicial do novo usuário
POST {{baseUrl}}/api/usuarios
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nome": "Maria da Secretaria",
  "email": "secretaria@temple.local",
  "senha": "{{senhaInicial}}",
  "membroId": "{{criarMembro.response.body.$.id}}",
  "perfis": ["Secretario"]
}

### Listar usuários
GET {{baseUrl}}/api/usuarios
Authorization: Bearer {{token}}

### Obter o usuário criado acima
GET {{baseUrl}}/api/usuarios/{{criarUsuario.response.body.$.id}}
Authorization: Bearer {{token}}

### Trocar os perfis do usuário criado acima (vale a partir do próximo login dele)
PUT {{baseUrl}}/api/usuarios/{{criarUsuario.response.body.$.id}}/perfis
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "perfis": ["Secretario", "Tesoureiro"]
}


### Vincular um usuário que ainda não tem membro (o REST Client pede os dois ids)
# @prompt usuarioId Id do usuário
# @prompt membroId Id do membro
PUT {{baseUrl}}/api/usuarios/{{usuarioId}}/membro
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "membroId": "{{membroId}}"
}

### Meu cadastro de membro (qualquer usuário logado)
GET {{baseUrl}}/api/membros/meu-cadastro
Authorization: Bearer {{token}}


### ===================== CERTIFICADOS (Pastor e Secretário) =====================

### Histórico do membro cadastrado acima (o primeiro item é a promoção a Cooperador)
# @name historico
GET {{baseUrl}}/api/membros/{{criarMembro.response.body.$.id}}/historico-cargos
Authorization: Bearer {{token}}

### Emitir o certificado da primeira promoção do histórico (devolve o PDF)
POST {{baseUrl}}/api/membros/{{criarMembro.response.body.$.id}}/historico-cargos/{{historico.response.body.$[0].id}}/certificado
Authorization: Bearer {{token}}

### Emitir de novo a mesma promoção (409: use a 2ª via)
POST {{baseUrl}}/api/membros/{{criarMembro.response.body.$.id}}/historico-cargos/{{historico.response.body.$[0].id}}/certificado
Authorization: Bearer {{token}}

### 2ª via pelo número impresso no certificado (o REST Client pede o número)
# @prompt numero Número do certificado
GET {{baseUrl}}/api/certificados/{{numero}}
Authorization: Bearer {{token}}

### Certificado que não existe (404)
GET {{baseUrl}}/api/certificados/999999
Authorization: Bearer {{token}}



### ===================== BATISMO (Pastor e Secretário) =====================

### Registrar o batismo do membro cadastrado acima
POST {{baseUrl}}/api/membros/{{criarMembro.response.body.$.id}}/batismo
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "dataBatismo": "2005-08-14",
  "oficiante": "Pr. Antônio Ferreira",
  "local": "Tanque batismal da igreja"
}

### Consultar o batismo do membro
GET {{baseUrl}}/api/membros/{{criarMembro.response.body.$.id}}/batismo
Authorization: Bearer {{token}}

### Corrigir o batismo (só enquanto não houver certificado)
PUT {{baseUrl}}/api/membros/{{criarMembro.response.body.$.id}}/batismo
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "dataBatismo": "2005-08-21",
  "oficiante": "Pr. Antônio Ferreira",
  "local": null
}

### Emitir o certificado de batismo (devolve o PDF)
POST {{baseUrl}}/api/membros/{{criarMembro.response.body.$.id}}/batismo/certificado
Authorization: Bearer {{token}}

### Corrigir depois do certificado (422)
PUT {{baseUrl}}/api/membros/{{criarMembro.response.body.$.id}}/batismo
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "dataBatismo": "2005-08-28",
  "oficiante": "Pr. Antônio Ferreira"
}


### ===================== APRESENTAÇÃO DE CRIANÇA (Pastor e Secretário) =====================

### Registrar uma apresentação na primeira igreja ativa
# @name criarApresentacao
POST {{baseUrl}}/api/apresentacoes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "igrejaId": "{{igrejasAtivas.response.body.$[0].id}}",
  "nomeDaCrianca": "Sofia Almeida",
  "dataNascimentoDaCrianca": "2025-06-02",
  "dataApresentacao": "2025-09-07",
  "oficiante": "Pr. Antônio Ferreira",
  "nomeDoPai": "Carlos Almeida",
  "nomeDaMae": "Juliana Almeida"
}

### Listar as apresentações (o filtro igrejaId é opcional)
GET {{baseUrl}}/api/apresentacoes
Authorization: Bearer {{token}}

### Obter a apresentação registrada acima
GET {{baseUrl}}/api/apresentacoes/{{criarApresentacao.response.body.$.id}}
Authorization: Bearer {{token}}

### Corrigir a apresentação (só enquanto não houver certificado)
PUT {{baseUrl}}/api/apresentacoes/{{criarApresentacao.response.body.$.id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nomeDaCrianca": "Sofia Almeida Souza",
  "dataNascimentoDaCrianca": "2025-06-02",
  "dataApresentacao": "2025-09-07",
  "oficiante": "Pr. Antônio Ferreira",
  "nomeDoPai": null,
  "nomeDaMae": "Juliana Almeida"
}

### Sem pai nem mãe (400)
POST {{baseUrl}}/api/apresentacoes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "igrejaId": "{{igrejasAtivas.response.body.$[0].id}}",
  "nomeDaCrianca": "Criança Sem Pais",
  "dataNascimentoDaCrianca": "2025-06-02",
  "dataApresentacao": "2025-09-07",
  "oficiante": "Pr. Antônio Ferreira"
}

### Criança com 12 anos ou mais na data (422)
POST {{baseUrl}}/api/apresentacoes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "igrejaId": "{{igrejasAtivas.response.body.$[0].id}}",
  "nomeDaCrianca": "Pedro Grande",
  "dataNascimentoDaCrianca": "2010-01-10",
  "dataApresentacao": "2025-09-07",
  "oficiante": "Pr. Antônio Ferreira",
  "nomeDaMae": "Ana Grande"
}

### Emitir o certificado da apresentação (devolve o PDF)
POST {{baseUrl}}/api/apresentacoes/{{criarApresentacao.response.body.$.id}}/certificado
Authorization: Bearer {{token}}